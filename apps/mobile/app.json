{
  "expo": {
    "name": "Meeting Copilot",
    "slug": "meeting-copilot",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.meetingcopilot.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Meeting Copilot records the meeting you're in to transcribe it and help you live. A red indicator shows whenever it records.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "dev.meetingcopilot.app",
      "permissions": ["RECORD_AUDIO", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_MICROPHONE", "POST_NOTIFICATIONS", "WAKE_LOCK"]
    },
    "plugins": [
      "expo-secure-store",
      [
        "@siteed/audio-studio",
        { "enableBackgroundAudio": true, "enableNotifications": true, "enablePhoneStateHandling": true }
      ]
    ],
    "extra": {
      "backendUrl": "http://127.0.0.1:8000"
    }
  }
}
