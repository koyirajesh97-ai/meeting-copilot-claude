{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@desktop/*": [
        "../desktop/src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../desktop/src/renderer/src",
    "../desktop/src/shared"
  ]
}
