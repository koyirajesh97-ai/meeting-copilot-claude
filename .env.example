# Required (free keys, no card needed)
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPGRAM_API_KEY=
HF_TOKEN=

# Optional extra fallbacks
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GLADIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Supabase (filled from `supabase status` when running locally)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

BACKEND_URL=http://127.0.0.1:8000
# Signs the short-lived tokens the desktop app uses (32+ random characters):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_SECRET=
# Postgres for quotas and meetings (local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres)
DATABASE_URL=
