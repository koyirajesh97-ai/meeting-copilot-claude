# Required (free keys, no card needed)
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPGRAM_API_KEY=
HF_TOKEN=

# Optional extra fallbacks
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GLADIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Supabase (filled from `supabase status` when running locally)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

BACKEND_URL=http://127.0.0.1:8000
# Signs the short-lived tokens the desktop app uses (32+ random characters):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_SECRET=
# Encrypts voiceprints (separately from everything else):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VOICEPRINT_KEY=
# Postgres for quotas and meetings (local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres)
# Leave empty to keep everything in memory (lost on restart).
DATABASE_URL=
# Verifies Supabase sign-ins. Newer Supabase stacks sign with asymmetric keys: SUPABASE_URL is
# enough. Older ones use a shared secret: set it here (from `supabase status`, "JWT secret").
SUPABASE_JWT_SECRET=

# Local development only:
# ALLOW_DEV_LOGIN=1          enables a "Use the local dev login" button (localhost only)
# COPILOT_FAKE_PROVIDERS=1   every AI provider is a Fake: no keys, no network
